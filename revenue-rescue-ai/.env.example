# Copy to .env.local. NEVER commit real values.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Postgres in production. Unset => embedded PGlite (dev/test only, persisted in .data/)
DATABASE_URL=
# Bootstrap the first internal admin (created on first admin login page visit if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integrations - each is PLACEHOLDER until set; see docs/ENVIRONMENT.md
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
